<div class="custom-ml-form-container">
  <div class="ml-form-align-center">
    <div class="ml-form-embedWrapper embedForm">
      <div class="ml-form-embedBody row-form">
        <div class="ml-form-embedContent">
          <h4>{{ block.title }}</h4>
          <p>{{ block.desc }}</p>
        </div>

        <form class="ml-block-form" id="vip-form-{{ block.ml_form_id }}" action="https://assets.mailerlite.com/jsonp/2113368/forms/{{ block.ml_form_id }}/subscribe" method="post" target="_blank">
          <div class="ml-form-formContent">
            
            <div class="ml-form-fieldRow">
              <div class="ml-field-group ml-field-email ml-validate-email ml-validate-required">
                <input aria-label="email" aria-required="true" type="email" class="form-control" name="fields[email]" placeholder="Email" autocomplete="email">
              </div>
            </div>

            <div class="ml-form-fieldRow">
              <div class="ml-field-group ml-field-name">
                <input aria-label="name" type="text" class="form-control" name="fields[name]" placeholder="CODE NAME" autocomplete="given-name">
              </div>
            </div>

            {# Ο ΔΙΑΚΟΠΤΗΣ ΤΟΥ CMS ΠΟΥ ΘΕΛΑΜΕ ΕΞΑΡΧΗΣ #}
            {% if block.form_type == "resistance" %}
            <div class="ml-form-fieldRow ml-last-item">
              <div class="ml-field-group ml-field-z_i_p ml-validate-required">
                <input id="resistance-code" aria-label="z_i_p" aria-required="true" type="text" class="form-control" name="fields[z_i_p]" placeholder="Κωδικός Φυσικού Κλειδιού (π.χ. 1001)">
              </div>
            </div>
            {% endif %}
            
          </div>

          <input type="hidden" name="ml-submit" value="1">
          <div class="ml-form-embedSubmit">
            <button type="submit" class="primary" id="submit-btn">ΕΠΙΒΕΒΑΙΩΣΗ</button>
          </div>
          <input type="hidden" name="anticsrf" value="true">
          
          {% if block.form_type == "resistance" %}
          <div id="error-msg" style="color: #ff003c; display: none; margin-top: 15px; font-weight: bold;">
            [ΣΦΑΛΜΑ] Άκυρο Σήμα. Ο κωδικός δεν αναγνωρίστηκε.
          </div>
          {% endif %}
        </form>
      </div>

      <div class="ml-form-successBody row-success" style="display: none">
        <div class="ml-form-successContent">
          <h4>ΣΗΜΑ ΕΛΗΦΘΗ</h4>
          <p>Η σύνδεση με το δίκτυο της Αντίστασης ολοκληρώθηκε.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% if block.form_type == "resistance" %}
<script>
  // Οι κωδικοί των VIPs
  const validCodes = ['1001', '2045', '3099', '4040']; 

  document.getElementById('vip-form-{{ block.ml_form_id }}').addEventListener('submit', function(e) {
    const inputCode = document.getElementById('resistance-code').value.trim();
    const errorMsg = document.getElementById('error-msg');
    
    if (!validCodes.includes(inputCode)) {
      e.preventDefault(); 
      errorMsg.style.display = 'block'; 
    } else {
      errorMsg.style.display = 'none'; 
    }
  });
</script>
{% endif %}
