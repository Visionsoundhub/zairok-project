<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PROJECT ZAIROK | {{ title }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script src="https://unpkg.com/swup@4"></script>
    <style>
        :root {
            --bg-color: #000000;
            --accent-color: {{ settings.color_accent | default('#ff8c00') }};
            --accent-dim: {{ settings.color_accent | default('#ff8c00') }}33;
            --error-color: {{ settings.color_error | default('#ff003c') }};
            --text-color: #e0e0e0;
            --font-display: 'Orbitron', sans-serif;
            --font-body: 'Inter', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: var(--bg-color); color: var(--text-color); font-family: var(--font-body); overflow-x: hidden; padding-bottom: 90px; }
        
        .scanlines, .crt-flicker { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 998; pointer-events: none; }
        .scanlines { background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2)); background-size: 100% 4px; }
        .crt-flicker { animation: flicker 0.15s infinite; background: rgba(255, 140, 0, 0.01); }
        @keyframes flicker { 0% { opacity: 0.97; } 50% { opacity: 1.0; } 100% { opacity: 0.98; } }

        /* GATE OVERLAY - ΥΨΗΛΟΤΕΡΟ Z-INDEX ΓΙΑ ΝΑ ΠΑΤΙΕΤΑΙ */
        #the-gate { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: var(--bg-color); z-index: 20000; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 1s ease-out; }
        .gate-content { text-align: center; border: 1px solid var(--accent-color); padding: 30px; box-shadow: 0 0 30px var(--accent-dim); max-width: 90%; position: relative; overflow: hidden; pointer-events: all; }
        .face-scan-line { position: absolute; top: 0; left: 0; width: 100%; height: 5px; background-color: var(--accent-color); box-shadow: 0 0 15px var(--accent-color); opacity: 0; pointer-events: none; }
        .scanning .face-scan-line { opacity: 1; animation: scanFace 1.5s ease-in-out infinite; }
        @keyframes scanFace { 0%, 100% { top: 0%; } 50% { top: 100%; } }
        .btn-access { background: transparent; border: 2px solid var(--accent-color); color: var(--accent-color); padding: 15px 30px; font-family: var(--font-display); font-size: 1.1rem; cursor: pointer; transition: 0.3s; text-transform: uppercase; letter-spacing: 2px; position: relative; z-index: 20001; }

        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 20px; margin-bottom: 50px; position: relative; z-index: 1001; }
        .logo-link { text-decoration: none; display: flex; align-items: center; }
        .logo-img { max-height: 40px; }
        .logo-text { font-family: var(--font-display); font-size: 1.5rem; font-weight: 900; color: var(--text-color); }

        /* HAMBURGER MENU */
        .menu-toggle { display: none; font-size: 1.8rem; color: var(--accent-color); background: none; border: none; cursor: pointer; z-index: 10005; }
        nav { display: flex; gap: 20px; }
        nav a, nav button { color: #888; text-decoration: none; font-family: var(--font-display); font-size: 0.85rem; text-transform: uppercase; transition: 0.3s; background: none; border: none; cursor: pointer; }

        @media (max-width: 768px) {
            .menu-toggle { display: block; }
            nav { 
                position: fixed; top: 0; right: -100%; width: 100%; height: 100vh; 
                background: rgba(0,0,0,0.98); z-index: 10004; 
                flex-direction: column; justify-content: center; align-items: center;
                transition: 0.4s ease-in-out;
            }
            nav.active { right: 0; }
            nav a, nav button { font-size: 1.5rem; margin: 15px 0; }
        }

        .transition-fade { opacity: 1; transition: 0.4s; }
        html.is-leaving .transition-fade { opacity: 0; }

        .container { max-width: 900px; margin: 0 auto; padding: 40px 20px; }
        section { margin-bottom: 80px; }
        .section-header { font-family: monospace; color: #666; margin-bottom: 15px; border-left: 3px solid var(--accent-color); padding-left: 15px; }
        .cyber-box { border: 1px solid #333; padding: 25px; background: rgba(10,10,10,0.8); }
        .cyber-input { width: 100%; background: transparent; border: 1px solid #444; color: #fff; padding: 15px; margin-bottom: 15px; font-family: var(--font-body); }
        .submit-btn { background: var(--accent-color); color: #000; border: none; padding: 15px 30px; cursor: pointer; font-family: var(--font-display); width: 100%; font-weight: bold; }

        #audio-bar { position: fixed; bottom: 0; left: 0; width: 100%; height: 70px; background: #050505; border-top: 1px solid var(--accent-color); display: flex; align-items: center; justify-content: space-between; padding: 0 20px; z-index: 990; }
        .player-controls button { background: transparent; border: 1px solid var(--accent-color); color: var(--accent-color); width: 40px; height: 40px; cursor: pointer; }
        
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 10001; display: flex; align-items: center; justify-content: center; }
        .hidden { display: none !important; }
    </style>
</head>
<body>
    <div class="scanlines"></div>
    <div class="crt-flicker"></div>

    <div id="the-gate">
        <div class="gate-content" id="gate-box">
            <div class="face-scan-line"></div>
            <h1>SYSTEM: FOUNDATION ZAIRA</h1>
            <p style="font-size: 0.8rem; color: #666; margin-bottom: 30px;">SECURE CONNECTION REQUIRED</p>
            <button id="enter-btn" class="btn-access">PRESS FOR ENCRYPTED ACCESS</button>
            <div id="gate-msg" style="margin-top:20px; font-family:var(--font-display); color:var(--accent-color);"></div>
        </div>
    </div>

    <audio id="main-audio" loop preload="auto"><source src="{{ settings.audio_loop }}" type="audio/mpeg"></audio>
    <audio id="access-sound" preload="auto"><source src="{{ settings.audio_access }}" type="audio/mpeg"></audio>

    <div id="audio-bar">
        <div class="player-controls"><button id="play-btn">▶</button></div>
        <div class="track-display">AUDIO_LOG: <span class="accent-text">{{ settings.audio_label | default('SIGNAL_DETECTED') }}</span></div>
        <div style="flex-grow: 1; height: 2px; background: #333; margin-left: 20px; position: relative;">
            <div id="progress-bar" style="width: 0%; height: 100%; background: var(--accent-color);"></div>
        </div>
    </div>

    <main id="swup" class="transition-fade">
        <div class="container">
            <header>
                <a href="/" class="logo-link">
                    {% if settings.site_logo %}<img src="{{ settings.site_logo }}" class="logo-img">{% else %}<span class="logo-text">ZAIROK</span>{% endif %}
                </a>
                <button class="menu-toggle" id="menu-toggle">☰</button>
                <nav id="nav-menu">
                    {% for item in settings.menu_items %}
                        {% if item.type == 'Modal' %}
                            <button onclick="openModal('{{ item.modal_title | escape }}', '{{ item.modal_text | replace('\n', '\\n') | escape }}')">{{ item.label }}</button>
                        {% else %}
                            <a href="{{ item.url }}">{{ item.label }}</a>
                        {% endif %}
                    {% endfor %}
                </nav>
            </header>

            {% for block in blocks %}
                {% set nr = "" %}{% if loop.index < 10 %}{% set nr = "0" ~ loop.index %}{% else %}{% set nr = loop.index %}{% endif %}
                
                {% if block.type == 'hero' %}
                <section>
                    <span class="section-header">{{ nr }} // {{ block.status | default('INIT') }}</span>
                    <h1 style="font-size: 2.5rem; line-height: 1.2;">{{ block.title }}<br><span class="accent-text">{{ block.subtitle }}</span></h1>
                    <p style="white-space: pre-line;">{{ block.text }}</p>
                </section>
                {% elif block.type == 'lore' %}
                <section>
                    <span class="section-header">{{ nr }} // DATABASE</span>
                    <div style="display: grid; gap: 30px;">
                    {% for item in block.items %}
                        <div><h3>{{ item.item_title }}</h3><p style="font-size: 0.9rem; color: #aaa;">{{ item.item_desc }}</p></div>
                    {% endfor %}
                    </div>
                </section>
                {% elif block.type == 'signup_form' %}
                <section>
                    <span class="section-header">{{ nr }} // CONNECTION</span>
                    <div class="cyber-box">
                        <h3>{{ block.title }}</h3>
                        <p style="font-size: 0.9rem; margin-bottom: 20px;">{{ block.desc }}</p>
                        <form name="contact" method="POST" data-netlify="true">
                            <input type="text" name="name" class="cyber-input" placeholder="CODE NAME" required>
                            <input type="email" name="email" class="cyber-input" placeholder="FREQUENCY (Email)" required>
                            <button type="submit" class="submit-btn">ESTABLISH LINK</button>
                        </form>
                    </div>
                </section>
                {% elif block.type == 'media_block' %}
                <section>
                    {% if block.image %}<img src="{{ block.image }}" style="max-width:100%; border:1px solid var(--accent-color);">{% endif %}
                    {% if block.video %}<div style="position:relative;padding-bottom:56.25%;height:0;margin-top:20px;"><iframe src="{{ block.video | replace('watch?v=', 'embed/') }}" style="position:absolute;top:0;left:0;width:100%;height:100%;" frameborder="0" allowfullscreen></iframe></div>{% endif %}
                </section>
                {% elif block.type == 'richtext' %}
                <section><div class="cyber-box">{{ block.body | safe }}</div></section>
                {% endif %}
            {% endfor %}
        </div>
    </main>

    <div id="modal" class="modal-overlay hidden"><div class="cyber-box" style="max-width:500px; width:90%; text-align:center;"><h2 id="modal-title" class="accent-text"></h2><p id="modal-body" style="margin:20px 0; white-space:pre-line;"></p><button onclick="closeModal()" class="submit-btn" style="width:auto; padding:10px 30px;">CLOSE</button></div></div>

    <script>
        const swup = new Swup();
        const audioEl = document.getElementById('main-audio');
        const accessSound = document.getElementById('access-sound');
        const playBtn = document.getElementById('play-btn');
        let isPlaying = false;

        const toggleMenu = () => document.getElementById('nav-menu').classList.toggle('active');
        document.getElementById('menu-toggle').addEventListener('click', toggleMenu);
        swup.on('contentReplaced', () => document.getElementById('nav-menu').classList.remove('active'));

        if(sessionStorage.getItem('zairok_access')) { document.getElementById('the-gate').style.display = 'none'; }

        document.getElementById('enter-btn').addEventListener('click', function() {
            // ΗΧΟΣ ΑΜΕΣΩΣ ΜΕ ΤΟ ΚΛΙΚ - Robust Check
            const loopSrc = audioEl.querySelector('source').getAttribute('src');
            const accessSrc = accessSound.querySelector('source').getAttribute('src');

            if(loopSrc && loopSrc !== "") {
                audioEl.volume = 0.4;
                audioEl.play().then(() => { isPlaying = true; playBtn.innerText = "❚❚"; }).catch(e => console.log("Loop blocked"));
            }
            if(accessSrc && accessSrc !== "") {
                accessSound.volume = 1.0; accessSound.play().catch(e => console.log("Access sound blocked"));
            }

            this.style.display = 'none';
            document.getElementById('gate-box').classList.add('scanning');
            document.getElementById('gate-msg').innerText = "{{ settings.scan_start_text }}";
            
            setTimeout(() => { document.getElementById('gate-msg').innerText = "{{ settings.scan_success_text }}"; }, 2000);
            setTimeout(() => { 
                document.getElementById('the-gate').style.opacity = '0';
                sessionStorage.setItem('zairok_access', 'true');
            }, 3000);
            setTimeout(() => { document.getElementById('the-gate').style.display = 'none'; }, 4000);
        });

        playBtn.addEventListener('click', () => {
            if(!isPlaying) { audioEl.play(); playBtn.innerText = "❚❚"; isPlaying = true; } 
            else { audioEl.pause(); playBtn.innerText = "▶"; isPlaying = false; }
        });

        audioEl.ontimeupdate = () => { if(audioEl.duration) document.getElementById('progress-bar').style.width = (audioEl.currentTime / audioEl.duration) * 100 + "%"; };

        function openModal(title, text) { document.getElementById('modal-title').innerText = title; document.getElementById('modal-body').innerText = text; document.getElementById('modal').classList.remove('hidden'); }
        function closeModal() { document.getElementById('modal').classList.add('hidden'); }
    </script>
</body>
</html>
