<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PROJECT ZAIROK | {{ title }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script src="https://unpkg.com/swup@4"></script>
    <style>
        :root {
            --bg-color: #000000;
            --accent-color: {{ settings.color_accent | default('#ff8c00') }};
            --accent-dim: {{ settings.color_accent | default('#ff8c00') }}33;
            --error-color: {{ settings.color_error | default('#ff003c') }};
            --text-color: #e0e0e0;
            --font-display: 'Orbitron', sans-serif;
            --font-body: 'Inter', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: var(--bg-color); color: var(--text-color); font-family: var(--font-body); overflow-x: hidden; padding-bottom: 90px; }
        
        /* CRT EFFECTS */
        .scanlines, .crt-flicker { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 998; pointer-events: none; }
        .scanlines { background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2)); background-size: 100% 4px; }
        .crt-flicker { animation: flicker 0.15s infinite; background: rgba(255, 140, 0, 0.01); }
        @keyframes flicker { 0% { opacity: 0.97; } 50% { opacity: 1.0; } 100% { opacity: 0.98; } }

        /* GATE OVERLAY - ΤΕΡΜΑ ΠΑΝΩ ΑΠΟ ΟΛΑ */
        #the-gate { 
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; 
            background-color: var(--bg-color); z-index: 99999; 
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
            transition: opacity 1s ease-out;
            pointer-events: all; /* Εξασφαλίζει ότι το overlay πιάνει τα κλικ */
        }
        .gate-content { 
            text-align: center; border: 1px solid var(--accent-color); padding: 40px; 
            box-shadow: 0 0 50px var(--accent-dim); max-width: 90%; 
            position: relative; overflow: hidden; 
            z-index: 100000;
        }
        .btn-access { 
            background: transparent; border: 2px solid var(--accent-color); color: var(--accent-color); 
            padding: 20px 40px; font-family: var(--font-display); font-size: 1.2rem; 
            cursor: pointer; transition: 0.3s; text-transform: uppercase; letter-spacing: 3px; 
            position: relative; z-index: 100001;
            pointer-events: auto !important; /* Force clickability */
        }
        .btn-access:hover { background: var(--accent-color); color: #000; box-shadow: 0 0 30px var(--accent-color); }

        /* HEADER & NAV - ΠΙΟ ΚΑΤΩ ΑΠΟ ΤΟ GATE */
        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 20px; margin-bottom: 50px; position: relative; z-index: 10; }
        
        /* HAMBURGER */
        .menu-toggle { display: none; font-size: 1.8rem; color: var(--accent-color); background: none; border: none; cursor: pointer; }
        nav { display: flex; gap: 20px; }
        @media (max-width: 768px) {
            .menu-toggle { display: block; }
            nav { position: fixed; top: 0; right: -100%; width: 100%; height: 100vh; background: rgba(0,0,0,0.98); z-index: 100; flex-direction: column; justify-content: center; align-items: center; transition: 0.4s; }
            nav.active { right: 0; }
        }

        .container { max-width: 900px; margin: 0 auto; padding: 40px 20px; }
        .cyber-box { border: 1px solid #333; padding: 25px; background: rgba(10,10,10,0.8); margin-bottom: 30px; }
        .hidden { display: none !important; }
        .fade-out { opacity: 0; pointer-events: none !important; }

        #audio-bar { position: fixed; bottom: 0; left: 0; width: 100%; height: 70px; background: #050505; border-top: 1px solid var(--accent-color); display: flex; align-items: center; justify-content: space-between; padding: 0 20px; z-index: 999; }
    </style>
</head>
<body>
    <div class="scanlines"></div>
    <div class="crt-flicker"></div>

    <div id="the-gate">
        <div class="gate-content" id="gate-box">
            <h1 style="font-family: var(--font-display); margin-bottom: 10px;">SYSTEM: FOUNDATION ZAIRA</h1>
            <p style="font-size: 0.8rem; color: #666; margin-bottom: 40px;">SECURE CONNECTION REQUIRED</p>
            <button id="enter-btn" class="btn-access">PRESS FOR ENCRYPTED ACCESS</button>
            <div id="gate-msg" style="margin-top:20px; font-family:var(--font-display); color:var(--accent-color); min-height: 1.2em;"></div>
        </div>
    </div>

    <audio id="main-audio" loop preload="auto"><source src="{{ settings.audio_loop }}" type="audio/mpeg"></audio>
    <audio id="access-sound" preload="auto"><source src="{{ settings.audio_access }}" type="audio/mpeg"></audio>

    <div id="audio-bar">
        <div class="player-controls"><button id="play-btn" style="background:transparent; border:1px solid var(--accent-color); color:var(--accent-color); width:40px; height:40px; cursor:pointer;">▶</button></div>
        <div style="font-family:var(--font-display); font-size:0.8rem;">AUDIO_LOG: <span style="color:var(--accent-color);">{{ settings.audio_label | default('SIGNAL_DETECTED') }}</span></div>
        <div style="flex-grow: 1; height: 2px; background: #333; margin-left: 20px;"><div id="progress-bar" style="width: 0%; height: 100%; background: var(--accent-color);"></div></div>
    </div>

    <main id="swup" class="transition-fade">
        <div class="container">
            <header>
                <a href="/" style="text-decoration:none;">
                    {% if settings.site_logo %}<img src="{{ settings.site_logo }}" style="max-height:40px;">{% else %}<span style="font-family:var(--font-display); font-size:1.5rem; color:#fff; font-weight:900;">ZAIROK</span>{% endif %}
                </a>
                <button class="menu-toggle" id="menu-toggle">☰</button>
                <nav id="nav-menu">
                    {% for item in settings.menu_items %}
                        <a href="{{ item.url }}" style="color:#888; text-decoration:none; font-family:var(--font-display); font-size:0.85rem; text-transform:uppercase;">{{ item.label }}</a>
                    {% endfor %}
                </nav>
            </header>

            {% for block in blocks %}
                <section style="margin-bottom:80px;">
                    {% if block.type == 'hero' %}
                        <span style="display:block; border-left:3px solid var(--accent-color); padding-left:15px; color:#666; font-family:monospace; margin-bottom:15px;">{{ loop.index }} // {{ block.status }}</span>
                        <h1 style="font-size:2.5rem;">{{ block.title }}<br><span style="color:var(--accent-color);">{{ block.subtitle }}</span></h1>
                        <p style="white-space:pre-line;">{{ block.text }}</p>
                    {% elif block.type == 'signup_form' %}
                        <div class="cyber-box">
                            <h3>{{ block.title }}</h3>
                            <p>{{ block.desc }}</p>
                            <form name="contact" method="POST" data-netlify="true" style="margin-top:20px;">
                                <input type="text" name="name" placeholder="CODE NAME" required style="width:100%; background:transparent; border:1px solid #444; color:#fff; padding:15px; margin-bottom:15px;">
                                <input type="email" name="email" placeholder="EMAIL" required style="width:100%; background:transparent; border:1px solid #444; color:#fff; padding:15px; margin-bottom:15px;">
                                <button type="submit" class="submit-btn">ESTABLISH LINK</button>
                            </form>
                        </div>
                    {% endif %}
                </section>
            {% endfor %}
        </div>
    </main>

    <script>
        console.log("System Initialized...");
        const swup = new Swup();
        const audioEl = document.getElementById('main-audio');
        const accessSound = document.getElementById('access-sound');
        const enterBtn = document.getElementById('enter-btn');

        if(sessionStorage.getItem('zairok_access')) { 
            document.getElementById('the-gate').style.display = 'none'; 
        }

        enterBtn.addEventListener('click', function() {
            console.log("Access Button Clicked!");
            
            // Audio Trigger
            try {
                audioEl.volume = 0.4; audioEl.play();
                accessSound.volume = 1.0; accessSound.play();
            } catch(e) { console.log("Audio play failed: ", e); }

            // UI Changes
            this.style.pointerEvents = 'none';
            this.innerText = "SCANNING...";
            document.getElementById('gate-msg').innerText = "RUNNING RETINA SCAN...";
            
            setTimeout(() => { document.getElementById('gate-msg').innerText = "IDENTITY CONFIRMED."; }, 2000);
            setTimeout(() => { 
                document.getElementById('the-gate').classList.add('fade-out');
                sessionStorage.setItem('zairok_access', 'true');
            }, 3000);
            setTimeout(() => { document.getElementById('the-gate').style.display = 'none'; }, 4000);
        });

        // Hamburger
        document.getElementById('menu-toggle').addEventListener('click', () => {
            document.getElementById('nav-menu').classList.toggle('active');
        });
    </script>
</body>
</html>
