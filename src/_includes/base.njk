<!DOCTYPE html>
<html lang="el">
<head>
    {% include "head.njk" %}
</head>
<body>
    {% include "system-ui.njk" %}

    <main id="swup" class="transition-fade">
        <div class="container">
            {% include "navbar.njk" %}
            {% if not (blocks | firstHero) %}<h1 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">ZAIROK · {{ title }}</h1>{% endif %}
            
            {{ content | safe }}

            {% include "blocks.njk" %}

            <footer style="margin-top: 60px; padding: 30px 0; border-top: 1px solid #222; text-align: center; font-size: 0.85rem; color: #666; font-family: monospace;">
                <div style="margin-bottom: 20px;">
                    <div style="color: var(--accent-color); font-family: var(--font-display); letter-spacing: 1px; font-size: 0.8rem; margin-bottom: 10px;">[ ΣΥΧΝΟΤΗΤΕΣ ΔΙΚΤΥΟΥ ]</div>
                    <div style="display: flex; justify-content: center; gap: 15px; flex-wrap: wrap;">
                        <a href="{{ settings.social.youtube | default('https://www.youtube.com/@zairok.universe') }}" target="_blank" rel="noopener" style="color: #aaa; text-decoration: none; border: 1px solid #333; padding: 6px 16px; font-family: var(--font-display); font-size: 0.75rem;">YOUTUBE</a>
                        {% if settings.social.facebook %}<a href="{{ settings.social.facebook }}" target="_blank" rel="noopener" style="color: #aaa; text-decoration: none; border: 1px solid #333; padding: 6px 16px; font-family: var(--font-display); font-size: 0.75rem;">FACEBOOK</a>{% endif %}
                        {% if settings.social.tiktok %}<a href="{{ settings.social.tiktok }}" target="_blank" rel="noopener" style="color: #aaa; text-decoration: none; border: 1px solid #333; padding: 6px 16px; font-family: var(--font-display); font-size: 0.75rem;">TIKTOK</a>{% endif %}
                        {% if settings.social.instagram %}<a href="{{ settings.social.instagram }}" target="_blank" rel="noopener" style="color: #aaa; text-decoration: none; border: 1px solid #333; padding: 6px 16px; font-family: var(--font-display); font-size: 0.75rem;">INSTAGRAM</a>{% endif %}
                    </div>
                </div>
                <p>© 2026 ZAIROK. Κατασκευή ιστοσελίδας: <a href="https://flowsites.gr" target="_blank" rel="noopener" style="color: var(--accent-color); text-decoration: none;">Flowsites</a></p>
            </footer>
        </div>
    </main>

    {% include "footer.njk" %}
</body>
</html>
