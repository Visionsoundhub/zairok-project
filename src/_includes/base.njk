<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PROJECT ZAIROK | {{ title }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script src="https://unpkg.com/swup@4"></script>
    <style>
        :root {
            --bg-color: #000000;
            --accent-color: {{ settings.color_accent | default('#ff8c00') }};
            --accent-dim: {{ settings.color_accent | default('#ff8c00') }}33;
            --error-color: {{ settings.color_error | default('#ff003c') }};
            --text-color: #e0e0e0;
            --font-display: 'Orbitron', sans-serif;
            --font-body: 'Inter', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: var(--bg-color); color: var(--text-color); font-family: var(--font-body); overflow-x: hidden; padding-bottom: 110px; }
        
        .scanlines, .crt-flicker { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 998; pointer-events: none; }
        .scanlines { background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2)); background-size: 100% 4px; }
        .crt-flicker { animation: flicker 0.15s infinite; background: rgba(255, 140, 0, 0.01); }
        @keyframes flicker { 0% { opacity: 0.97; } 50% { opacity: 1.0; } 100% { opacity: 0.98; } }

        /* GATE OVERLAY - BULLETPROOF */
        #the-gate { 
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; 
            background-color: var(--bg-color); z-index: 999998; 
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
            transition: opacity 1s ease-out; pointer-events: auto;
        }
        .gate-content { 
            text-align: center; border: 1px solid var(--accent-color); padding: 40px; 
            box-shadow: 0 0 50px var(--accent-dim); max-width: 90%; 
            position: relative; overflow: hidden; z-index: 999999;
        }
        .btn-access { 
            background: transparent; border: 2px solid var(--accent-color); color: var(--accent-color); 
            padding: 20px 40px; font-family: var(--font-display); font-size: 1.2rem; 
            cursor: pointer; transition: 0.3s; text-transform: uppercase; letter-spacing: 2px;
            pointer-events: auto !important; position: relative; z-index: 1000000;
        }
        .btn-access:hover { background: var(--accent-color); color: #000; box-shadow: 0 0 30px var(--accent-color); }

        /* HEADER */
        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding: 20px 0; margin-bottom: 50px; position: relative; z-index: 1000; }
        .logo-text { font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--text-color); text-decoration: none; }
        
        /* MOBILE MENU SETTINGS */
        .menu-toggle { display: none; font-size: 3rem; color: var(--accent-color); background: none; border: none; cursor: pointer; z-index: 10005; padding: 10px; }
        nav { display: flex; gap: 20px; }
        nav a, nav button { color: #888; text-decoration: none; font-family: var(--font-display); font-size: 0.9rem; text-transform: uppercase; transition: 0.3s; background: none; border: none; cursor: pointer; }

        @media (max-width: 768px) {
            .menu-toggle { display: block; }
            nav { 
                position: fixed; top: 0; right: -100%; width: 100%; height: 100vh; 
                background: rgba(0,0,0,0.98); backdrop-filter: blur(15px); z-index: 10004; 
                flex-direction: column; justify-content: center; align-items: center;
                transition: 0.5s cubic-bezier(0.7, 0, 0.3, 1);
            }
            nav.active { right: 0; }
            nav a, nav button { 
                font-size: 2.5rem !important; /* ΠΡΑΓΜΑΤΙΚΑ ΜΕΓΑΛΑ ΓΡΑΜΜΑΤΑ */
                margin: 20px 0; color: var(--accent-color); font-weight: 900; letter-spacing: 3px;
            }
        }

        .container { max-width: 900px; margin: 0 auto; padding: 0 20px; }
        section { margin-bottom: 80px; }
        .section-header { font-family: monospace; color: #666; margin-bottom: 15px; border-left: 3px solid var(--accent-color); padding-left: 15px; text-transform: uppercase; }
        
        /* LORE GRID FIX */
        .lore-grid { display: grid; gap: 40px; }
        .lore-item h3 { color: var(--accent-color); margin-bottom: 10px; font-family: var(--font-display); }
        .lore-item p { color: #aaa; line-height: 1.7; font-size: 1rem; }

        .cyber-box { border: 1px solid #333; padding: 25px; background: rgba(10,10,10,0.8); }

        /* AUDIO BAR - ALWAYS ON TOP */
        #audio-bar { 
            position: fixed; bottom: 0; left: 0; width: 100%; height: 85px; 
            background: #050505; border-top: 1px solid var(--accent-color); 
            display: flex; align-items: center; justify-content: space-between; 
            padding: 0 20px; z-index: 999995; pointer-events: auto;
        }
        .player-controls button { 
            background: transparent; border: 2px solid var(--accent-color); 
            color: var(--accent-color); width: 50px; height: 50px; 
            cursor: pointer; font-size: 1.4rem; display: flex; align-items: center; justify-content: center;
        }
        
        .transition-fade { opacity: 1; transition: 0.4s; }
        html.is-leaving .transition-fade { opacity: 0; }
        .hidden { display: none !important; }
    </style>
</head>
<body>
    <div class="scanlines"></div>
    <div class="crt-flicker"></div>

    <div id="the-gate">
        <div class="gate-content" id="gate-box">
            <h1 style="font-family: var(--font-display); margin-bottom: 10px;">SYSTEM: FOUNDATION ZAIRA</h1>
            <p style="font-size: 0.8rem; color: #666; margin-bottom: 30px;">SECURE CONNECTION REQUIRED</p>
            <button id="enter-btn" class="btn-access">PRESS FOR ENCRYPTED ACCESS</button>
            <div id="gate-msg" style="margin-top:20px; font-family:var(--font-display); color:var(--accent-color); min-height: 1.2em;"></div>
        </div>
    </div>

    <audio id="main-audio" loop preload="auto"><source src="{{ settings.audio_loop }}" type="audio/mpeg"></audio>
    <audio id="access-sound" preload="auto"><source src="{{ settings.audio_access }}" type="audio/mpeg"></audio>

    <div id="audio-bar">
        <div class="player-controls"><button id="play-btn">▶</button></div>
        <div style="margin-left:15px; font-size:0.75rem; font-family:var(--font-display);">
            SIGNAL: <span style="color:var(--accent-color);">{{ settings.audio_label | default('UNKNOWN') }}</span>
        </div>
        <div style="flex-grow: 1; height: 2px; background: #333; margin-left: 20px;"><div id="progress-bar" style="width: 0%; height: 100%; background: var(--accent-color);"></div></div>
    </div>

    <main id="swup" class="transition-fade">
        <div class="container">
            <header>
                <a href="/" class="logo-text">{% if settings.site_logo %}<img src="{{ settings.site_logo }}" style="max-height:45px;">{% else %}ZAIROK{% endif %}</a>
                <button class="menu-toggle" id="menu-toggle">☰</button>
                <nav id="nav-menu">
                    {% for item in settings.menu_items %}
                        <a href="{{ item.url }}">{{ item.label }}</a>
                    {% endfor %}
                </nav>
            </header>

            {% for block in blocks %}
                {% set nr = loop.index if loop.index > 9 else "0" ~ loop.index %}
                
                {% if block.type == 'hero' %}
                <section>
                    <span class="section-header">{{ nr }} // {{ block.status | default('INIT') }}</span>
                    <h1 style="font-size: 2.5rem;">{{ block.title }}<br><span style="color:var(--accent-color);">{{ block.subtitle }}</span></h1>
                    <p style="white-space: pre-line;">{{ block.text }}</p>
                </section>

                {% elif block.type == 'lore' %}
                <section>
                    <span class="section-header">{{ nr }} // DATABASE</span>
                    <div class="lore-grid">
                    {% for item in block.items %}
                        <div class="lore-item">
                            <h3>{{ item.item_title }}</h3>
                            <p style="white-space: pre-line;">{{ item.item_desc }}</p>
                        </div>
                    {% endfor %}
                    </div>
                </section>

                {% elif block.type == 'signup_form' %}
                <section>
                    <div class="cyber-box">
                        <h3>{{ block.title }}</h3>
                        <p style="margin-bottom:20px;">{{ block.desc }}</p>
                        <form name="contact" method="POST" data-netlify="true">
                            <input type="text" name="name" style="width:100%; background:transparent; border:1px solid #444; color:#fff; padding:15px; margin-bottom:15px;" placeholder="CODE NAME" required>
                            <input type="email" name="email" style="width:100%; background:transparent; border:1px solid #444; color:#fff; padding:15px; margin-bottom:15px;" placeholder="EMAIL" required>
                            <button type="submit" class="submit-btn">ESTABLISH LINK</button>
                        </form>
                    </div>
                </section>

                {% elif block.type == 'media_block' %}
                <section>
                    {% if block.image %}<img src="{{ block.image }}" style="max-width:100%; border:1px solid var(--accent-color); margin-bottom:20px;">{% endif %}
                    {% if block.video %}<div style="position:relative;padding-bottom:56.25%;height:0;"><iframe src="{{ block.video | replace('watch?v=', 'embed/') }}" style="position:absolute;top:0;left:0;width:100%;height:100%;" frameborder="0" allowfullscreen></iframe></div>{% endif %}
                </section>
                {% endif %}
            {% endfor %}
        </div>
    </main>

    <script>
        const swup = new Swup();
        const audioEl = document.getElementById('main-audio');
        const accessSound = document.getElementById('access-sound');
        const playBtn = document.getElementById('play-btn');
        const enterBtn = document.getElementById('enter-btn');
        let isPlaying = false;

        function initMenu() {
            const toggle = document.getElementById('menu-toggle');
            const nav = document.getElementById('nav-menu');
            if (toggle) {
                toggle.onclick = (e) => {
                    e.stopPropagation();
                    nav.classList.toggle('active');
                };
            }
        }

        initMenu();
        swup.on('contentReplaced', initMenu);

        if(sessionStorage.getItem('zairok_access')) { 
            document.getElementById('the-gate').style.display = 'none'; 
        }

        if (enterBtn) {
            enterBtn.onclick = function() {
                console.log("Accessing encrypted archives...");
                
                // Audio initiation
                try {
                    audioEl.volume = 0.4;
                    audioEl.play().then(() => { isPlaying = true; playBtn.innerText = "❚❚"; });
                    accessSound.volume = 1.0;
                    accessSound.play();
                } catch(err) { console.warn("Audio interaction pending..."); }

                this.style.pointerEvents = 'none';
                this.innerText = "SCANNING...";
                document.getElementById('gate-msg').innerText = "{{ settings.scan_start_text }}";
                
                setTimeout(() => { document.getElementById('gate-msg').innerText = "{{ settings.scan_success_text }}"; }, 2000);
                setTimeout(() => { 
                    document.getElementById('the-gate').style.opacity = '0';
                    sessionStorage.setItem('zairok_access', 'true');
                }, 3000);
                setTimeout(() => { document.getElementById('the-gate').style.display = 'none'; }, 4000);
            };
        }

        playBtn.onclick = () => {
            if(!isPlaying) { audioEl.play(); playBtn.innerText = "❚❚"; isPlaying = true; } 
            else { audioEl.pause(); playBtn.innerText = "▶"; isPlaying = false; }
        };

        audioEl.ontimeupdate = () => { if(audioEl.duration) document.getElementById('progress-bar').style.width = (audioEl.currentTime / audioEl.duration) * 100 + "%"; };
    </script>
</body>
</html>
