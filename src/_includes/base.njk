<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PROJECT ZAIROK | {{ title }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script src="https://unpkg.com/swup@4"></script>
    <style>
        :root {
            --bg-color: #000000;
            --accent-color: {{ settings.color_accent | default('#ff8c00') }};
            --accent-dim: {{ settings.color_accent | default('#ff8c00') }}33;
            --error-color: {{ settings.color_error | default('#ff003c') }};
            --text-color: #e0e0e0;
            --font-display: 'Orbitron', sans-serif;
            --font-body: 'Inter', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: var(--bg-color); color: var(--text-color); font-family: var(--font-body); line-height: 1.6; overflow-x: hidden; font-size: 16px; padding-bottom: 90px; }
        
        .scanlines, .crt-flicker { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 998; pointer-events: none; }
        .scanlines { background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2)); background-size: 100% 4px; }
        .crt-flicker { animation: flicker 0.15s infinite; background: rgba(255, 140, 0, 0.01); }
        @keyframes flicker { 0% { opacity: 0.97; } 50% { opacity: 1.0; } 100% { opacity: 0.98; } }

        /* HEADER & LOGO */
        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 20px; margin-bottom: 50px; }
        .logo-link { text-decoration: none; display: flex; align-items: center; }
        .logo-img { max-height: 50px; width: auto; }
        .logo-text { font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--text-color); letter-spacing: -1px; }

        /* GATE */
        #the-gate { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: var(--bg-color); z-index: 10000; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 1s ease-out; }
        .gate-content { text-align: center; border: 1px solid var(--accent-color); padding: 30px; box-shadow: 0 0 30px var(--accent-dim); max-width: 90%; position: relative; overflow: hidden; }
        .face-scan-line { position: absolute; top: 0; left: 0; width: 100%; height: 5px; background-color: var(--accent-color); box-shadow: 0 0 15px var(--accent-color); opacity: 0; pointer-events: none; }
        .scanning .face-scan-line { opacity: 1; animation: scanFace 1.5s ease-in-out infinite; }
        @keyframes scanFace { 0%, 100% { top: 0%; } 50% { top: 100%; } }
        .btn-access { background: transparent; border: 2px solid var(--accent-color); color: var(--accent-color); padding: 15px 30px; font-family: var(--font-display); font-size: 1.1rem; cursor: pointer; transition: 0.3s; text-transform: uppercase; letter-spacing: 2px; }
        .btn-access:hover { background: var(--accent-color); color: var(--bg-color); box-shadow: 0 0 30px var(--accent-color); }

        /* SWUP TRANSITION */
        .transition-fade { opacity: 1; transition: 0.4s; }
        html.is-leaving .transition-fade { opacity: 0; transform: translateY(10px); }

        .container { max-width: 900px; margin: 0 auto; padding: 40px 20px; position: relative; z-index: 10; }
        h1, h2, h3 { font-family: var(--font-display); text-transform: uppercase; margin-bottom: 1rem; }
        .accent-text { color: var(--accent-color); }
        nav a, nav button { color: #888; text-decoration: none; margin-left: 15px; font-family: var(--font-display); font-size: 0.85rem; text-transform: uppercase; transition: 0.3s; background: none; border: none; cursor: pointer; }
        nav a:hover, nav button:hover { color: var(--accent-color); }

        /* SECTIONS */
        section { margin-bottom: 80px; }
        .section-header { font-family: monospace; color: #666; margin-bottom: 15px; display: block; border-left: 3px solid var(--accent-color); padding-left: 15px; }
        .cyber-box { border: 1px solid #333; padding: 25px; background: rgba(10,10,10,0.8); }

        /* AUDIO BAR (Εκτός Swup για να μην σταματάει) */
        #audio-bar { position: fixed; bottom: 0; left: 0; width: 100%; height: 70px; background: #050505; border-top: 1px solid var(--accent-color); display: flex; align-items: center; justify-content: space-between; padding: 0 20px; z-index: 990; }
        .player-controls button { background: transparent; border: 1px solid var(--accent-color); color: var(--accent-color); width: 40px; height: 40px; cursor: pointer; font-size: 1.2rem; }
        
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 10001; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(5px); }
        .hidden { display: none !important; }
        .fade-out { opacity: 0; pointer-events: none; }

        @media (max-width: 600px) { .track-display { display: none; } }
    </style>
</head>
<body>
    <div class="scanlines"></div>
    <div class="crt-flicker"></div>

    <div id="the-gate">
        <div class="gate-content" id="gate-box">
            <div class="face-scan-line"></div>
            <h1>SYSTEM: FOUNDATION ZAIRA</h1>
            <p style="font-size: 0.8rem; color: #666; margin-bottom: 30px;">SECURE CONNECTION REQUIRED</p>
            <button id="enter-btn" class="btn-access">PRESS FOR ENCRYPTED ACCESS</button>
            <div id="gate-msg" class="gate-msg" style="margin-top:20px; font-family:var(--font-display); color:var(--accent-color);"></div>
        </div>
    </div>

    <audio id="main-audio" loop preload="auto"><source src="{{ settings.audio_loop }}" type="audio/mpeg"></audio>
    <audio id="access-sound" preload="auto"><source src="{{ settings.audio_access }}" type="audio/mpeg"></audio>

    <div id="audio-bar">
        <div class="player-controls"><button id="play-btn">▶</button></div>
        <div class="track-display">AUDIO_LOG: <span class="accent-text">{{ settings.audio_label | default('SIGNAL_DETECTED') }}</span></div>
        <div style="flex-grow: 1; height: 2px; background: #333; margin-left: 20px; position: relative;">
            <div id="progress-bar" style="width: 0%; height: 100%; background: var(--accent-color);"></div>
        </div>
    </div>

    <main id="swup" class="transition-fade">
        <div class="container">
            <header>
                <a href="/" class="logo-link">
                    {% if settings.site_logo %}
                        <img src="{{ settings.site_logo }}" alt="ZAIROK" class="logo-img">
                    {% else %}
                        <span class="logo-text">ZAIROK</span>
                    {% endif %}
                </a>
                <nav>
                    {% for item in settings.menu_items %}
                        {% if item.type == 'Modal' %}
                            <button onclick="openModal('{{ item.modal_title | escape }}', '{{ item.modal_text | replace('\n', '\\n') | escape }}')">{{ item.label }}</button>
                        {% else %}
                            <a href="{{ item.url }}">{{ item.label }}</a>
                        {% endif %}
                    {% endfor %}
                </nav>
            </header>

            {% for block in blocks %}
                {% set nr = "" %}{% if loop.index < 10 %}{% set nr = "0" ~ loop.index %}{% else %}{% set nr = loop.index %}{% endif %}
                
                {% if block.type == 'hero' %}
                <section>
                    <span class="section-header">{{ nr }} // {{ block.status | default('INIT') }}</span>
                    <h1 style="font-size: 2.5rem; line-height: 1.2;">{{ block.title }}<br><span class="accent-text">{{ block.subtitle }}</span></h1>
                    <p style="white-space: pre-line;">{{ block.text }}</p>
                </section>
                {% endif %}

                {% if block.type == 'lore' %}
                <section>
                    <span class="section-header">{{ nr }} // DATABASE</span>
                    <div style="display: grid; gap: 30px;">
                    {% for item in block.items %}
                        <div><h3>{{ item.item_title }}</h3><p style="font-size: 0.9rem; color: #aaa;">{{ item.item_desc }}</p></div>
                    {% endfor %}
                    </div>
                </section>
                {% endif %}
                {% endfor %}
        </div>
    </main>

    <div id="modal" class="modal-overlay hidden">
        <div class="modal-box" style="border: 2px solid var(--accent-color); padding: 30px; text-align: center; max-width: 500px; background: #000;">
            <h2 id="modal-title" style="color: var(--accent-color);"></h2>
            <p id="modal-body" style="margin-bottom: 20px; white-space: pre-line;"></p>
            <button onclick="closeModal()" style="background:transparent; border:1px solid var(--error-color); color:var(--error-color); padding:10px 20px; cursor:pointer;">CLOSE</button>
        </div>
    </div>

    <script>
        const swup = new Swup();
        const audioEl = document.getElementById('main-audio');
        const accessSound = document.getElementById('access-sound');
        const playBtn = document.getElementById('play-btn');
        const progressBar = document.getElementById('progress-bar');
        let isPlaying = false;

        if(sessionStorage.getItem('zairok_access')) { document.getElementById('the-gate').style.display = 'none'; }

        document.getElementById('enter-btn').addEventListener('click', function() {
            // 1. ΞΕΚΙΝΑΕΙ Η ΜΟΥΣΙΚΗ ΑΚΑΡΙΑΙΑ
            if(audioEl.querySelector('source').getAttribute('src')) {
                audioEl.volume = 0.4;
                audioEl.play().then(() => { isPlaying = true; playBtn.innerText = "❚❚"; });
            }
            if(accessSound.querySelector('source').getAttribute('src')) {
                accessSound.volume = 1.0; accessSound.play();
            }

            // 2. ΞΕΚΙΝΑΕΙ ΤΟ VISUAL
            this.style.display = 'none';
            document.getElementById('gate-box').classList.add('scanning');
            document.getElementById('gate-msg').innerText = "{{ settings.scan_start_text }}";
            
            setTimeout(() => { document.getElementById('gate-msg').innerText = "{{ settings.scan_success_text }}"; }, 2000);
            setTimeout(() => { 
                document.getElementById('the-gate').classList.add('fade-out');
                sessionStorage.setItem('zairok_access', 'true');
            }, 3000);
            setTimeout(() => { document.getElementById('the-gate').style.display = 'none'; }, 4000);
        });

        playBtn.addEventListener('click', () => {
            if(!isPlaying) { audioEl.play(); playBtn.innerText = "❚❚"; isPlaying = true; } 
            else { audioEl.pause(); playBtn.innerText = "▶"; isPlaying = false; }
        });

        audioEl.ontimeupdate = () => {
            if(audioEl.duration) progressBar.style.width = (audioEl.currentTime / audioEl.duration) * 100 + "%";
        };

        function openModal(title, text) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-body').innerText = text;
            document.getElementById('modal').classList.remove('hidden');
        }
        function closeModal() { document.getElementById('modal').classList.add('hidden'); }
    </script>
</body>
</html>
