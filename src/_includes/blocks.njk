{% for block in blocks %}
    {% set nr = loop.index if loop.index > 9 else "0" ~ loop.index %}

    <section>
        {% if block.type == 'hero' %}
            <span class="section-header">{{ nr }} // {{ block.status | default('INIT') }}</span>
            <h1 style="font-size: {{ block.custom_styles.title_size | default('var(--title-size)') }}; font-family: var(--font-display);">{{ block.title }}<br><span style="color:var(--accent-color);">{{ block.subtitle }}</span></h1>
            <p style="white-space: pre-line; font-size: {{ block.custom_styles.text_size | default('var(--text-size)') }};">{{ block.text }}</p>
            {% if block.button_url %}
                <a href="{{ block.button_url }}" target="_blank" class="btn-access" style="display:inline-block; margin-top:20px; text-decoration:none;">{{ block.button_text | default('INITIATE LINK') }}</a>
            {% endif %}
        
        {% elif block.type == 'lore' %}
            <span class="section-header">{{ nr }} // DATABASE</span>
            <div style="display: grid; gap: 40px;">
            {% for item in block.items %}
                <div>
                    <h3 style="color:var(--accent-color); font-family:var(--font-display); font-size: {{ block.custom_styles.title_size | default('calc(var(--title-size) * 0.7)') }};">{{ item.item_title }}</h3>
                    <p style="white-space: pre-line; color:#aaa; font-size: {{ block.custom_styles.text_size | default('var(--text-size)') }};">{{ item.item_desc }}</p>
                </div>
            {% endfor %}
            </div>
            {% if block.button_url %}
                <a href="{{ block.button_url }}" target="_blank" class="btn-access" style="display:inline-block; margin-top:30px; text-decoration:none;">{{ block.button_text | default('ACCESS FILES') }}</a>
            {% endif %}

        {% elif block.type == 'terminal_intro' %}
            <div class="terminal-vip-container" style="margin-bottom: 40px; min-height: 100px;">
                <div id="vip-terminal-{{ loop.index }}" style="font-family: monospace; color: {{ block.color | default('#00ff00') }}; font-size: {{ block.size | default('1.1rem') }}; white-space: pre-line; text-shadow: 0 0 5px {{ block.color | default('#00ff00') }};"></div>
                <script>
                    (function() {
                        var text = `{{ block.text | replace('\\', '\\\\') | replace('\`', '\\\`') | replace('$', '\\$') | safe }}`;
                        var i = 0;
                        var speed = {{ block.speed | default(30) }};
                        var container = document.getElementById('vip-terminal-{{ loop.index }}');
                        function typeVIP() {
                            if (i < text.length) {
                                container.innerHTML += text.charAt(i);
                                i++;
                                setTimeout(typeVIP, speed);
                            }
                        }
                        setTimeout(typeVIP, 500);
                    })();
                </script>
            </div>

        {% elif block.type == 'vip_chapter' %}
            <div id="vip-folder-{{ loop.index }}" class="vip-folder">
                <div class="vip-folder-header" onclick="toggleFolder{{ loop.index }}()">
                    <h3 class="vip-folder-title">{{ block.title }}</h3>
                    <span class="vip-folder-icon" id="vip-icon-{{ loop.index }}">+</span>
                </div>

                <div id="vip-folder-content-{{ loop.index }}" class="vip-folder-content">
                    <div class="vip-actions" style="display: flex; gap: 15px; flex-wrap: wrap; align-items: center;">
                        <button onclick="toggleVipSimpleText{{ loop.index }}()" style="background: transparent; border: 1px solid #aaa; color: #fff; padding: 10px 20px; cursor: pointer; font-family: monospace; font-size: 1rem; transition: 0.3s;">
                            {{ block.button_labels.read | default('[ ΔΙΑΒΑΣΕ ]') }}
                        </button>
                        
                        {% if block.audio %}
                        <button onclick="openCinematic{{ loop.index }}()" style="background: var(--accent-color, #ff8c00); border: 1px solid var(--accent-color, #ff8c00); color: #000; padding: 10px 20px; cursor: pointer; font-family: monospace; font-size: 1rem; font-weight: bold; transition: 0.3s;">
                            {{ block.button_labels.cinematic | default('[ ΑΚΟΥ ΚΑΙ ΔΙΑΒΑΣΕ ]') }}
                        </button>
                        {% else %}
                        <div style="background: rgba(255,140,0,0.05); border: 1px dashed #444; color: #666; padding: 10px 20px; font-family: monospace; font-size: 0.9rem; cursor: not-allowed; opacity: 0.8;">
                            {{ block.audio_status_msg | default('[ TRANSMISSION ENCRYPTED ]') }}
                        </div>
                        {% endif %}

                        {% if block.pdf %}
                        <a href="{{ block.pdf }}" target="_blank" style="background: transparent; border: 1px dashed #555; color: #aaa; padding: 10px 20px; cursor: pointer; font-family: monospace; font-size: 1rem; text-decoration: none; transition: 0.3s;">
                            {{ block.button_labels.pdf_btn | default('[ PDF (OFFLINE) ]') }}
                        </a>
                        {% endif %}
                    </div>

                    <div id="vip-content-{{ loop.index }}" class="markdown-content" style="display: none; margin-top: 30px; border-top: 1px dashed #555; padding-top: 25px; color: #ddd; font-size: 1.1rem;">
                        {{ block.content | markdown | safe }}
                    </div>
                </div>
            </div>

            {% if block.audio %}
            <div id="cinematic-overlay-{{ loop.index }}" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: #000; z-index: 99999; overflow-y: auto; padding: 60px 20px; box-sizing: border-box;">
                
                <button onclick="closeCinematic{{ loop.index }}()" style="position: fixed; top: 25px; right: 25px; background: rgba(255, 0, 60, 0.1); color: #ff003c; border: 1px solid #ff003c; padding: 10px 20px; cursor: pointer; font-family: monospace; font-weight: bold; font-size: 1rem; z-index: 100000; backdrop-filter: blur(5px); transition: 0.3s;">
                    {{ block.button_labels.stop | default('[ ΣΤΟΠ & ΕΠΙΣΤΡΟΦΗ ]') }}
                </button>

                <div style="max-width: 800px; margin: 0 auto; position: relative;">
                    <h2 style="color: var(--accent-color, #ff8c00); font-family: monospace; text-align: center; margin-bottom: 50px; font-size: 2rem;">{{ block.title }}</h2>
                    
                    <div style="margin-bottom: 50px; padding: 40px; border: 1px dashed var(--accent-color, #ff8c00); background: rgba(255,140,0,0.03); border-radius: 8px;">
                        <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 30px;">
                            <div id="vip-waveform-{{ loop.index }}" class="waveform paused">
                                <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
                            </div>
                            <span id="vip-audio-status-{{ loop.index }}" style="margin-left: 25px; font-family: var(--font-display); font-size: 1.2rem; color: #555; transition: 0.3s;">TRANSMISSION READY...</span>
                        </div>
                        
                        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap; align-items: center;">
                            <button id="vip-btn-play-{{ loop.index }}" class="terminal-btn mini" onclick="toggleVipAudio{{ loop.index }}()" style="padding: 12px 25px; font-size: 1rem; background: transparent; border: 1px solid var(--accent-color); color: var(--accent-color); font-family: monospace; cursor: pointer; font-weight: bold;">[ PLAY ]</button>
                            
                            <div style="display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.05); padding: 5px 15px; border: 1px solid #333;">
                                <span style="font-family: monospace; font-size: 0.8rem; color: #666;">VOL:</span>
                                <input type="range" id="vip-vol-{{ loop.index }}" min="0" max="1" step="0.1" value="1" oninput="document.getElementById('vip-audio-{{ loop.index }}').volume = this.value" style="width: 80px; accent-color: var(--accent-color); cursor: pointer;">
                            </div>

                            <button id="vip-btn-readalong-{{ loop.index }}" class="terminal-btn mini" onclick="toggleVipReadAlong{{ loop.index }}()" style="padding: 12px 25px; font-size: 1rem; background: transparent; border: 1px solid #aaa; color: #aaa; font-family: monospace; cursor: pointer;">{{ block.button_labels.open_text | default('[ ΑΝΟΙΓΜΑ ΚΕΙΜΕΝΟΥ ]') }}</button>
                        </div>
                        
                        <audio id="vip-audio-{{ loop.index }}" preload="none">
                            <source src="{{ block.audio }}" type="audio/mpeg">
                        </audio>
                    </div>

                    <div id="vip-cinematic-text-{{ loop.index }}" class="markdown-content" style="display: none; color: #ccc; font-size: 1.2rem; padding-bottom: 100px;">
                        {{ block.content | markdown | safe }}
                    </div>
                </div>
            </div>

            <script>
                var isVipPlaying{{ loop.index }} = false;
                var isVipTextOpen{{ loop.index }} = false;

                function toggleFolder{{ loop.index }}() {
                    var folder = document.getElementById('vip-folder-{{ loop.index }}');
                    var content = document.getElementById('vip-folder-content-{{ loop.index }}');
                    if (folder.classList.contains('active')) {
                        folder.classList.remove('active');
                        content.style.display = 'none';
                    } else {
                        folder.classList.add('active');
                        content.style.display = 'block';
                    }
                }

                function toggleVipSimpleText{{ loop.index }}() {
                    var simpleText = document.getElementById('vip-content-{{ loop.index }}');
                    simpleText.style.display = simpleText.style.display === 'none' ? 'block' : 'none';
                }

                function openCinematic{{ loop.index }}() {
                    document.getElementById('cinematic-overlay-{{ loop.index }}').style.display = 'block';
                    document.body.style.overflow = 'hidden'; 
                    var mainAudio = document.getElementById('main-audio');
                    if(mainAudio) { mainAudio.volume = 0.1; }
                }

                function closeCinematic{{ loop.index }}() {
                    var overlay = document.getElementById('cinematic-overlay-{{ loop.index }}');
                    var audio = document.getElementById('vip-audio-{{ loop.index }}');
                    var mainAudio = document.getElementById('main-audio');
                    var waveform = document.getElementById('vip-waveform-{{ loop.index }}');
                    var status = document.getElementById('vip-audio-status-{{ loop.index }}');
                    var playBtn = document.getElementById('vip-btn-play-{{ loop.index }}');

                    overlay.style.display = 'none';
                    
                    if(audio) {
                        audio.pause();
                        audio.currentTime = 0;
                        isVipPlaying{{ loop.index }} = false;
                    }
                    
                    if(waveform) waveform.classList.add('paused');
                    if(status) {
                        status.innerText = "TRANSMISSION READY...";
                        status.style.color = "#555";
                        status.style.animation = "none";
                    }
                    if(playBtn) playBtn.innerText = "[ PLAY ]";

                    if(mainAudio && typeof isPlaying !== 'undefined' && isPlaying) { mainAudio.volume = 0.4; }
                    document.body.style.overflow = 'auto';
                }

                function toggleVipAudio{{ loop.index }}() {
                    var audio = document.getElementById('vip-audio-{{ loop.index }}');
                    var waveform = document.getElementById('vip-waveform-{{ loop.index }}');
                    var status = document.getElementById('vip-audio-status-{{ loop.index }}');
                    var playBtn = document.getElementById('vip-btn-play-{{ loop.index }}');

                    if(!audio) return;

                    if(isVipPlaying{{ loop.index }}) {
                        audio.pause();
                        isVipPlaying{{ loop.index }} = false;
                        waveform.classList.add('paused');
                        status.innerText = "TRANSMISSION PAUSED...";
                        status.style.color = "#555";
                        status.style.animation = "none";
                        playBtn.innerText = "[ PLAY ]";
                    } else {
                        audio.play();
                        isVipPlaying{{ loop.index }} = true;
                        waveform.classList.remove('paused');
                        status.innerText = "PLAYING TRANSMISSION...";
                        status.style.color = "var(--accent-color, #ff8c00)";
                        status.style.animation = "blink 1s infinite";
                        playBtn.innerText = "[ ΠΑΥΣΗ ]";
                    }
                }

                function toggleVipReadAlong{{ loop.index }}() {
                    var textDiv = document.getElementById('vip-cinematic-text-{{ loop.index }}');
                    var readBtn = document.getElementById('vip-btn-readalong-{{ loop.index }}');
                    
                    if(isVipTextOpen{{ loop.index }}) {
                        textDiv.style.display = 'none';
                        isVipTextOpen{{ loop.index }} = false;
                        readBtn.innerText = "{{ block.button_labels.open_text | default('[ ΑΝΟΙΓΜΑ ΚΕΙΜΕΝΟΥ ]') }}";
                    } else {
                        textDiv.style.display = 'block';
                        isVipTextOpen{{ loop.index }} = true;
                        readBtn.innerText = "{{ block.button_labels.close_text | default('[ ΚΛΕΙΣΙΜΟ ΚΕΙΜΕΝΟΥ ]') }}";
                        setTimeout(() => { textDiv.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 100);
                    }
                }
            </script>
            {% endif %}

        {% elif block.type == 'vip_feedback' %}
            <div class="vip-feedback-container" style="border: 1px solid var(--accent-color); padding: 30px; background: rgba(0,0,0,0.7); margin-bottom: 40px; margin-top: 20px;">
                <h3 style="color: var(--accent-color); font-family: monospace; border-bottom: 1px dashed #333; padding-bottom: 15px; margin-bottom: 25px; font-size: 1.2rem;">{{ block.title | default('[ ΑΝΑΦΟΡΕΣ ΠΡΑΚΤΟΡΩΝ ]') }}</h3>
                
                <form id="fb-form-{{ loop.index }}" style="margin-bottom: 40px; background: #0a0a0a; padding: 20px; border: 1px solid #222;">
                    <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 15px;">
                        <input type="text" id="fb-name-{{ loop.index }}" placeholder="[ CODE NAME ]" required style="flex: 1; min-width: 200px; background: #000; border: 1px solid #444; color: #0f0; padding: 12px; font-family: monospace;">
                        
                        <div style="display: flex; align-items: center; gap: 10px; background: #000; border: 1px solid #444; padding: 0 15px;">
                            <span style="color: #666; font-family: monospace; font-size: 0.8rem;">RATING:</span>
                            <div class="star-rating">
                                <input type="radio" id="star5-{{ loop.index }}" name="rating-{{ loop.index }}" value="5" required/><label for="star5-{{ loop.index }}" title="5 stars">★</label>
                                <input type="radio" id="star4-{{ loop.index }}" name="rating-{{ loop.index }}" value="4"/><label for="star4-{{ loop.index }}" title="4 stars">★</label>
                                <input type="radio" id="star3-{{ loop.index }}" name="rating-{{ loop.index }}" value="3"/><label for="star3-{{ loop.index }}" title="3 stars">★</label>
                                <input type="radio" id="star2-{{ loop.index }}" name="rating-{{ loop.index }}" value="2"/><label for="star2-{{ loop.index }}" title="2 stars">★</label>
                                <input type="radio" id="star1-{{ loop.index }}" name="rating-{{ loop.index }}" value="1"/><label for="star1-{{ loop.index }}" title="1 star">★</label>
                            </div>
                        </div>
                    </div>
                    <textarea id="fb-msg-{{ loop.index }}" placeholder="> ΕΙΣΑΓΩΓΗ ΑΝΑΦΟΡΑΣ..." required rows="4" style="width: 100%; background: #000; border: 1px solid #444; color: #ccc; padding: 12px; font-family: monospace; margin-bottom: 15px; resize: vertical;"></textarea>
                    
                    <button type="submit" id="fb-btn-{{ loop.index }}" style="background: var(--accent-color); color: #000; border: none; padding: 12px 25px; font-family: monospace; font-weight: bold; cursor: pointer; width: 100%; transition: 0.3s;">[ TRANSMIT DATA ]</button>
                    <div id="fb-spinner-{{ loop.index }}" class="loading-spinner" style="display: none; border-top-color: #000; width: 20px; height: 20px; margin-top: -30px; margin-bottom: 10px;"></div>
                </form>

                <div id="fb-list-{{ loop.index }}" style="display: flex; flex-direction: column; gap: 20px;">
                    <div style="color: #666; font-family: monospace; font-size: 0.9rem;">> ΦΟΡΤΩΣΗ ΑΡΧΕΙΟΥ...</div>
                </div>
            </div>

            <script type="module">
                import { initializeApp, getApps, getApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
                import { getFirestore, collection, addDoc, onSnapshot, query, where, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

                const firebaseConfig = {
                    apiKey: "AIzaSyALGEhN8YHapgn6acN8SAXEz8E5eVw7JN8",
                    authDomain: "zairok-vip-network.firebaseapp.com",
                    projectId: "zairok-vip-network",
                    storageBucket: "zairok-vip-network.firebasestorage.app",
                    messagingSenderId: "488545339709",
                    appId: "1:488545339709:web:6fc94816c0d1d37943dd54"
                };

                const app = !getApps().length ? initializeApp(firebaseConfig) : getApp();
                const db = getFirestore(app);
                const feedbackRef = collection(db, "vip_feedback");
                const topicId = "{{ block.topic_id | default('general') }}";

                const q = query(feedbackRef, where("topic", "==", topicId));
                onSnapshot(q, (snapshot) => {
                    const listDiv = document.getElementById("fb-list-{{ loop.index }}");
                    if (!listDiv) return;
                    
                    if (snapshot.empty) {
                        listDiv.innerHTML = '<div style="color: #666; font-family: monospace; font-size: 0.9rem;">> ΚΑΝΕΝΑ ΔΕΔΟΜΕΝΟ ΣΤΟ ΑΡΧΕΙΟ. ΑΝΑΜΟΝΗ ΠΡΩΤΗΣ ΑΝΑΦΟΡΑΣ...</div>';
                        return;
                    }

                    let docs = [];
                    snapshot.forEach(doc => docs.push(doc.data()));
                    docs.sort((a, b) => {
                        const timeA = a.timestamp ? a.timestamp.toMillis() : Date.now();
                        const timeB = b.timestamp ? b.timestamp.toMillis() : Date.now();
                        return timeB - timeA; 
                    });

                    listDiv.innerHTML = "";
                    docs.forEach((data) => {
                        let starsHTML = '<span style="color: var(--accent-color);">';
                        for(let i=0; i<5; i++) { starsHTML += (i < data.rating) ? '★' : '<span style="color:#444">★</span>'; }
                        starsHTML += '</span>';

                        const dateStr = data.timestamp ? new Date(data.timestamp.toDate()).toLocaleString('el-GR') : 'LIVE DATA...';

                        listDiv.innerHTML += `
                            <div style="border-left: 2px solid var(--accent-color); padding-left: 15px; background: rgba(0,0,0,0.3); padding: 15px;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; border-bottom: 1px dashed #222; padding-bottom: 8px;">
                                    <div style="font-family: monospace; color: var(--accent-color); font-size: 1rem; font-weight: bold;">
                                        >_ ${data.name}
                                    </div>
                                    <div style="font-family: monospace; font-size: 0.8rem; color: #666;">
                                        ${dateStr} &nbsp;//&nbsp; ${starsHTML}
                                    </div>
                                </div>
                                <div style="color: #ccc; font-size: 1.05rem; line-height: 1.6; font-family: var(--font-body); white-space: pre-line;">
                                    ${data.message}
                                </div>
                            </div>
                        `;
                    });
                });

                const form = document.getElementById("fb-form-{{ loop.index }}");
                if(form) {
                    form.addEventListener("submit", async (e) => {
                        e.preventDefault();
                        const btn = document.getElementById("fb-btn-{{ loop.index }}");
                        const spinner = document.getElementById("fb-spinner-{{ loop.index }}");
                        
                        const name = document.getElementById("fb-name-{{ loop.index }}").value;
                        const msg = document.getElementById("fb-msg-{{ loop.index }}").value;
                        let rating = 5; 
                        const ratingInputs = document.getElementsByName("rating-{{ loop.index }}");
                        for(let radio of ratingInputs) {
                            if(radio.checked) { rating = parseInt(radio.value); break; }
                        }

                        btn.style.color = "transparent";
                        spinner.style.display = "block";

                        try {
                            await addDoc(feedbackRef, {
                                topic: topicId,
                                name: name,
                                message: msg,
                                rating: rating,
                                timestamp: serverTimestamp()
                            });
                            form.reset();
                        } catch (err) {
                            console.error("Firebase Error: ", err);
                            alert("> ΣΦΑΛΜΑ ΣΥΣΤΗΜΑΤΟΣ. Η ΑΝΑΦΟΡΑ ΑΠΕΤΥΧΕ.");
                        } finally {
                            btn.style.color = "#000";
                            spinner.style.display = "none";
                        }
                    });
                }
            </script>

        {% elif block.type == 'signup_form' %}
            {% if block.form_type == "resistance" %}
            <div class="resistance-form-container" style="border: 1px solid var(--accent-color); padding: 25px; background: rgba(5,5,5,0.9); position: relative;">
                <button onclick="document.getElementById('terminal-instructions').classList.toggle('hidden')" style="position: absolute; top: -15px; right: 20px; background: #000; border: 1px solid var(--accent-color); color: var(--accent-color); padding: 5px 15px; font-family: var(--font-display); font-size: 0.8rem; cursor: pointer; z-index: 10;">[ ? ] ΟΔΗΓΙΕΣ</button>
                <div id="terminal-instructions" class="hidden" style="background: #111; border: 1px dashed #555; padding: 15px; margin-bottom: 20px; font-size: 0.85rem; color: #aaa;">
                    <strong style="color:var(--accent-color);">ΟΔΗΓΙΕΣ ΠΡΟΣΒΑΣΗΣ:</strong><br>
                    1. Πατήστε "ΕΝΑΡΞΗ ΣΥΝΔΕΣΗΣ" για να ανοίξει το ασφαλές κανάλι.<br>
                    2. Διαβάστε την εισερχόμενη μετάδοση.<br>
                    3. Μόλις ολοκληρωθεί, θα εμφανιστούν τα πεδία εισαγωγής.<br>
                    4. Συμπληρώστε το Code Name, το Email σας και τον Μοναδικό Κωδικό από τη φυσική σας κάρτα (αν έχετε).<br>
                    5. Αποδεχτείτε το Πρωτόκολλο Ασφαλείας (Όροι Χρήσης) και πατήστε "ESTABLISH LINK".
                </div>
                <div class="row-form">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid #333; padding-bottom: 10px;">
                        <h3 style="color:var(--accent-color); font-family:var(--font-display); font-size: 1.5rem; margin: 0;">{{ block.title }}</h3>
                        <button id="skip-res-btn" onclick="window.skipResTerminal()" style="display: none; background: #000; border: 1px dashed var(--accent-color); color: var(--accent-color); padding: 5px 15px; font-family: var(--font-display); font-size: 0.8rem; cursor: pointer;">[ SKIP ]</button>
                    </div>
                    <div id="terminal-screen" style="font-family: monospace; color: #00ff00; font-size: 1rem; min-height: 200px; margin-bottom: 20px; white-space: pre-line; text-shadow: 0 0 5px #00ff00; display: none;"></div>
                    <button id="start-terminal-btn" onclick="window.startTerminal()" style="background:transparent; color:var(--accent-color); border:2px solid var(--accent-color); padding:15px 30px; cursor:pointer; font-family:var(--font-display); width:100%; font-weight:bold; letter-spacing: 2px;">[ ΕΝΑΡΞΗ ΣΥΝΔΕΣΗΣ ]</button>
                    
                    <form id="resistance-gateway" style="display: none; margin-top: 20px;">
                        <input type="text" id="form-name" placeholder="[1] CODE NAME" style="width:100%; background:rgba(0,0,0,0.5); border:1px solid #444; color:#0f0; padding:15px; margin-bottom:15px; font-family: monospace;" required>
                        <input type="email" id="form-email" placeholder="[2] ΚΑΝΑΛΙ ΕΠΙΚΟΙΝΩΝΙΑΣ (Email)" style="width:100%; background:rgba(0,0,0,0.5); border:1px solid #444; color:#0f0; padding:15px; margin-bottom:15px; font-family: monospace;" required>
                        <input type="text" id="form-code" placeholder="[3] ΦΥΣΙΚΟ ΚΛΕΙΔΙ ΠΡΟΣΒΑΣΗΣ" style="width:100%; background:rgba(20,10,0,0.5); border:1px solid var(--accent-color); color:var(--accent-color); padding:15px; margin-bottom:15px; font-family: monospace;" required>
                        
                        <div class="gdpr-terms-container" style="background: #0a0a0a; padding: 10px; border: 1px solid #222;">
                            <input type="checkbox" id="resistance-terms" name="terms" required class="gdpr-checkbox">
                            <label for="resistance-terms" class="gdpr-label">
                                [ ] ΑΠΟΔΟΧΗ ΠΡΩΤΟΚΟΛΛΟΥ ΑΣΦΑΛΕΙΑΣ <span class="gdpr-link" onclick="openGdprModal()">(Όροι Χρήσης)</span>
                            </label>
                        </div>
                        <button type="submit" id="form-submit-btn" style="background:var(--accent-color); color:#000; border:none; padding:15px 30px; cursor:pointer; font-family:var(--font-display); width:100%; font-weight:bold; margin-top: 15px;">ESTABLISH LINK</button>
                    </form>
                </div>
                <div class="row-success" style="display: none; text-align: center; padding: 30px 0;">
                    <h3 id="success-title" style="color:var(--accent-color); font-family:var(--font-display); margin-bottom:10px;">SIGNAL ESTABLISHED</h3>
                    <p id="success-msg" style="color:#0f0; font-family: monospace;">> Πρόσβαση εγκρίθηκε. Η κρυπτογράφηση ολοκληρώθηκε.</p>
                </div>
            </div>
            {% endif %}

        {% elif block.type == 'richtext' %}
            <div class="markdown-content">
                {{ block.body | markdown | safe }}
            </div>

        {% endif %}
    </section>
{% endfor %}
