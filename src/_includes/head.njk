<script defer src="/sig.js"></script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

{% set seoDesc = settings.seo.description | default('Το hybrid sci-fi project ZAIROK. Επίλεξε το επίπεδό σου και μπες στο Δίκτυο.') %}
{% set seoImg = settings.seo.og_image | default(settings.site_logo) %}
{% set displayTitle = "Hybrid Sci-Fi Novel" if title == "Home" else title %}

<title>ZAIROK | {{ displayTitle }}</title>
{% set pageDesc = description or (seoDesc if page.url == "/" else displayTitle + " · " + seoDesc) %}
<meta name="description" content="{{ pageDesc }}">

<meta property="og:type" content="website">
{% set isPrivate = ('secure' in page.url) or ('vip' in page.url) or ('404' in page.url) %}
<link rel="canonical" href="https://zairok.gr{{ page.url }}">
<meta name="robots" content="{{ 'noindex, nofollow' if isPrivate else 'index, follow, max-image-preview:large, max-snippet:-1' }}">
<meta property="og:site_name" content="ZAIROK">
<meta property="og:locale" content="el_GR">
<meta property="og:url" content="https://zairok.gr{{ page.url }}">
<meta property="og:title" content="ZAIROK | {{ displayTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
{% if seoImg %}<meta property="og:image" content="https://zairok.gr{{ seoImg }}">{% endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="ZAIROK | {{ displayTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
{% if seoImg %}<meta name="twitter:image" content="https://zairok.gr{{ seoImg }}">{% endif %}

{% if settings.seo.favicon %}
<link rel="icon" type="image/png" href="{{ settings.seo.favicon }}">
{% elif settings.site_logo %}
<link rel="icon" type="image/png" href="{{ settings.site_logo }}">
{% endif %}

<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{% if page.url == "/" %}
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebSite","name":"ZAIROK","url":"https://zairok.gr/","inLanguage":"el","sameAs":["https://www.youtube.com/@zairok.universe","https://www.facebook.com/Zairok.Verse","https://www.tiktok.com/@zairok.verse","https://www.instagram.com/zairok.verse/"]},{"@type":"CreativeWorkSeries","name":"ZAIROK","url":"https://zairok.gr/","genre":["Science fiction","Cyberpunk"],"inLanguage":"el","description":"{{ seoDesc }}","sameAs":["https://www.youtube.com/@zairok.universe","https://www.facebook.com/Zairok.Verse","https://www.tiktok.com/@zairok.verse","https://www.instagram.com/zairok.verse/"]}]}</script>
{% elif not isPrivate %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"ZAIROK","item":"https://zairok.gr/"},{"@type":"ListItem","position":2,"name":"{{ displayTitle }}","item":"https://zairok.gr{{ page.url }}"}]}</script>
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
<script src="https://unpkg.com/swup@4" defer></script>
<script src="https://unpkg.com/@swup/scripts-plugin@2" defer></script>

<style>
    :root {
        --title-size: {{ settings.global_typography.title_desk | default('2.5rem') }};
        --text-size: {{ settings.global_typography.text_desk | default('1rem') }};
        --bg-color: #000000;
        --accent-color: {{ settings.color_accent | default('#ff8c00') }};
        --accent-dim: {{ settings.color_accent | default('#ff8c00') }}33;
        --error-color: {{ settings.color_error | default('#ff003c') }};
        --text-color: #e0e0e0;
        --font-display: 'Orbitron', sans-serif;
        --font-body: 'Inter', sans-serif;
    }

    @media (max-width: 768px) {
        :root {
            --title-size: {{ settings.global_typography.title_mob | default('1.8rem') }};
            --text-size: {{ settings.global_typography.text_mob | default('0.95rem') }};
        }
    }
    
    nav .menu-modal-trigger { color: var(--error-color) !important; font-weight: bold; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: var(--bg-color); color: var(--text-color); font-family: var(--font-body); overflow-x: hidden; padding-bottom: 110px; }
    
    .scanlines, .crt-flicker { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 998; pointer-events: none; }
    .scanlines { background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2)); background-size: 100% 4px; }
    .crt-flicker { animation: flicker 0.15s infinite; background: rgba(255, 140, 0, 0.01); }

    #the-gate { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: var(--bg-color); z-index: 2147483647; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 1s ease-out; }
    .gate-content { text-align: center; border: 1px solid var(--accent-color); padding: 40px; box-shadow: 0 0 50px var(--accent-dim); max-width: 90%; position: relative; overflow: hidden; }
    .face-scan-line { position: absolute; top: 0; left: 0; width: 100%; height: 5px; background-color: var(--accent-color); box-shadow: 0 0 15px var(--accent-color); opacity: 0; pointer-events: none; }
    .scanning .face-scan-line { opacity: 1; animation: scanFace 1.5s ease-in-out infinite; }
    @keyframes scanFace { 0%, 100% { top: 0%; } 50% { top: 100%; } }
    @keyframes flicker { 0% { opacity: 0.97; } 50% { opacity: 1.0; } 100% { opacity: 0.98; } }

    .btn-access { background: transparent; border: 2px solid var(--accent-color); color: var(--accent-color); padding: 20px 40px; font-family: var(--font-display); font-size: 1.2rem; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; }

    #modal-container h2 { color: var(--error-color) !important; font-family: var(--font-display); }
    #modal-container button { background: var(--error-color) !important; color: #000 !important; font-weight: bold; }

    header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding: 20px 0; margin-bottom: 50px; position: relative; z-index: 1000; }
    .logo-text { font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--text-color); text-decoration: none; }
    
    .menu-toggle { display: none; font-size: 2.5rem; color: var(--accent-color); background: none; border: none; cursor: pointer; z-index: 10005; padding: 10px; }
    nav { display: flex; gap: 20px; align-items: center; }
    nav a, nav button { color: #888; text-decoration: none; font-family: var(--font-display); font-size: 0.85rem; text-transform: uppercase; transition: 0.3s; background: none; border: none; cursor: pointer; }

    .menu-close-mobile { display: none; }

    @media (max-width: 768px) {
        .menu-toggle { display: block; }
        .menu-close-mobile { display: block; position: absolute; top: 25px; right: 25px; background: none; border: none; color: var(--accent-color); font-size: 2rem; cursor: pointer; }
        nav { position: fixed; top: 0; right: -100%; width: 100%; height: 100vh; background: rgba(0,0,0,0.98); backdrop-filter: blur(15px); z-index: 10004; flex-direction: column; justify-content: center; align-items: center; transition: 0.4s ease-in-out; gap: 30px; }
        nav.active { right: 0; }
        nav a, nav button { font-size: 1.6rem !important; color: var(--accent-color); font-weight: 700; }
        .gate-content { padding: 30px 15px !important; }
        .btn-access { padding: 14px 20px !important; font-size: 0.95rem !important; letter-spacing: 1px !important; }
    }

    .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
    section { margin-bottom: 80px; }
    .section-header { font-family: monospace; color: #9a9a9a; margin-bottom: 15px; border-left: 3px solid var(--accent-color); padding-left: 15px; text-transform: uppercase; }

    #audio-bar { position: fixed; bottom: 0; left: 0; width: 100%; height: 85px; background: #050505; border-top: 1px solid var(--accent-color); display: flex; align-items: center; justify-content: space-between; padding: 0 20px; z-index: 2000000; pointer-events: auto; }
    .player-controls button { background: transparent; border: 2px solid var(--accent-color); color: var(--accent-color); width: 50px; height: 50px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    
    .hidden { display: none !important; }
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 40000; display: flex; align-items: center; justify-content: center; }
    
    .loading-spinner { display: none; width: 20px; height: 20px; border: 3px solid rgba(255,255,255,.3); border-radius: 50%; border-top-color: var(--accent-color); animation: spin 1s ease-in-out infinite; margin: 10px auto; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .gdpr-terms-container { margin-top: 15px; margin-bottom: 20px; text-align: left; }
    .gdpr-checkbox { display: inline-block; width: auto; margin-right: 8px; accent-color: var(--accent-color); }
    .gdpr-label { display: inline; color: #cccccc; font-size: 0.85em; cursor: pointer; }
    .gdpr-link { color: var(--accent-color); text-decoration: underline; cursor: pointer; }
    .gdpr-link:hover { color: #ffffff; }
    .gdpr-modal-content { background-color: #0d0d0d; color: #cccccc; padding: 30px; border: 1px solid var(--accent-color); width: 90%; max-width: 600px; max-height: 80vh; overflow-y: auto; text-align: left; font-family: var(--font-body); }
    .gdpr-modal-content h2 { color: var(--accent-color) !important; border-bottom: 1px solid #333; padding-bottom: 15px; margin-top: 0; font-family: var(--font-display); font-size: 1.2em; text-align: left; }
    .gdpr-modal-content ul { padding-left: 20px; line-height: 1.6; font-size: 0.9em; margin-bottom: 20px; }
    .gdpr-modal-content li { margin-bottom: 12px; }
    .gdpr-modal-content strong { color: #ffffff; }
    .gdpr-close-btn { background: transparent !important; border: 1px solid #333 !important; color: #888 !important; padding: 10px 20px !important; width: 100%; transition: 0.3s; }
    .gdpr-close-btn:hover { background: #333 !important; color: #fff !important; }

    /* GLOBAL WAVEFORM STYLES FOR PLAYERS */
    .waveform { display: flex; align-items: center; gap: 8px; height: 60px; }
    .waveform .bar { width: 8px; background: var(--accent-color, #ff8c00); height: 10px; animation: wave 1s ease-in-out infinite; }
    .waveform .bar:nth-child(1) { animation-delay: 0.0s; }
    .waveform .bar:nth-child(2) { animation-delay: 0.2s; }
    .waveform .bar:nth-child(3) { animation-delay: 0.4s; }
    .waveform .bar:nth-child(4) { animation-delay: 0.6s; }
    .waveform .bar:nth-child(5) { animation-delay: 0.8s; }
    @keyframes wave { 0%, 100% { height: 10px; } 50% { height: 60px; box-shadow: 0 0 10px var(--accent-color); } }
    .waveform.paused .bar { animation-play-state: paused; }

    /* MARKDOWN TEXT FIXES */
    .markdown-content img { max-width: 100%; height: auto; border: 1px solid #333; border-radius: 4px; display: block; margin: 30px auto; box-shadow: 0 5px 25px rgba(0,0,0,0.8); }
    .markdown-content p { margin-bottom: 25px; line-height: 1.8; }
    .markdown-content strong { color: #fff; }

    /* ACCORDION (VIP FOLDER) STYLES */
    .vip-folder { border: 1px solid var(--accent-color, #ff8c00); margin-bottom: 15px; background: rgba(0,0,0,0.6); transition: 0.3s; }
    .vip-folder-header { padding: 20px 25px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
    .vip-folder-header:hover { background: rgba(255,140,0,0.1); }
    .vip-folder-title { color: var(--accent-color, #ff8c00); margin: 0; font-family: monospace; font-size: 1.3rem; font-weight: bold; }
    .vip-folder-icon { color: var(--accent-color, #ff8c00); font-family: monospace; font-size: 1.5rem; transition: transform 0.3s; }
    .vip-folder.active .vip-folder-icon { transform: rotate(45deg); }
    .vip-folder-content { display: none; padding: 0 25px 25px 25px; border-top: 1px dashed #444; margin-top: 15px; padding-top: 25px; }

    /* FEEDBACK STARS STYLING */
    .star-rating { display: flex; flex-direction: row-reverse; justify-content: flex-end; font-size: 1.5rem; }
    .star-rating input { display: none; }
    .star-rating label { cursor: pointer; color: #444; margin: 0 2px; }
    .star-rating label:hover, .star-rating label:hover ~ label, .star-rating input:checked ~ label { color: var(--accent-color, #ff8c00); }
</style>
