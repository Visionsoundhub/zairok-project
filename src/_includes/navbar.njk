<style>
    /* Εφέ Hover και Active State για το Μενού */
    #nav-menu a, 
    #nav-menu .menu-modal-trigger {
        transition: color 0.3s ease;
    }
    
    #nav-menu a:hover, 
    #nav-menu .menu-modal-trigger:hover,
    #nav-menu a.current-link {
        color: var(--accent-color) !important;
    }
</style>

<header>
    <a href="/" class="logo-text">{% if settings.site_logo %}<img src="{{ settings.site_logo }}" alt="ZAIROK" style="max-height:45px;">{% else %}ZAIROK{% endif %}</a>
    <button class="menu-toggle" aria-label="Άνοιγμα μενού" onclick="document.getElementById('nav-menu').classList.toggle('active')">☰</button>

    <nav id="nav-menu">
        <button class="menu-close-mobile" aria-label="Κλείσιμο μενού" onclick="document.getElementById('nav-menu').classList.remove('active')">✕</button>
        {% for item in settings.menu_items %}
            {% if item.type == 'Modal' %}
                <button class="menu-modal-trigger" onclick="openModal('{{ item.modal_title | escape }}', '{{ item.modal_text | replace('\n', '\\n') | escape }}'); document.getElementById('nav-menu').classList.remove('active');">{{ item.label }}</button>
            {% else %}
                <a href="{{ item.url }}" onclick="document.getElementById('nav-menu').classList.remove('active')" class="{% if page.url == item.url %}current-link{% endif %}">{{ item.label }}</a>
            {% endif %}
        {% endfor %}
    </nav>
</header>
