<div class="product-card" style="border: 1px solid var(--accent-color); padding: 20px; background: rgba(5,5,5,0.95); margin-bottom: 40px; position: relative; box-shadow: 0 0 20px rgba(255,140,0,0.1);">
    {# Status Tag #}
    <div style="position: absolute; top: 0; right: 0; background: var(--accent-color); color: #000; padding: 3px 12px; font-family: monospace; font-size: 0.75rem; font-weight: bold;">
        [ STATUS: {{ block.status }} ]
    </div>

    <div style="display: flex; flex-wrap: wrap; gap: 25px; align-items: flex-start;">
        {# Image #}
        {% if block.image %}
        <div style="flex: 1; min-width: 260px; border: 1px solid #222;">
            <img src="{{ block.image }}" alt="{{ block.title }}" style="width: 100%; display: block; filter: contrast(1.1);">
        </div>
        {% endif %}

        {# Content #}
        <div style="flex: 1.5; min-width: 260px;">
            <h2 style="color: var(--accent-color); font-family: var(--font-display); margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 1.5px;">{{ block.title }}</h2>
            
            <div style="color: #00ff00; font-family: monospace; font-size: 1.8rem; font-weight: bold; margin-bottom: 20px;">
                {{ block.price }}
            </div>

            <p style="color: #bbb; line-height: 1.7; font-size: 0.95rem; margin-bottom: 30px; border-left: 2px solid var(--accent-color); padding-left: 15px;">
                {{ block.description }}
            </p>

            <a href="{{ block.payhip_url }}" target="_blank" style="display: block; background: var(--accent-color); color: #000; text-align: center; padding: 16px; text-decoration: none; font-family: var(--font-display); font-weight: bold; letter-spacing: 2px;">
                [ ESTABLISH PURCHASE CONNECTION ]
            </a>
        </div>
    </div>
</div>
