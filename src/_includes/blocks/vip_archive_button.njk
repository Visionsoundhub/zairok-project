<div style="text-align: center; margin: 50px 0; padding: 30px; border: 1px dashed var(--accent-color, #ff8c00); background: rgba(255,140,0,0.05);">
    <h3 style="color: #ccc; font-family: monospace; margin-bottom: 20px; font-size: 1.1rem;">[ OFFLINE DATABASE READY ]</h3>
    
    {% if block.pdf_url %}
    <a href="{{ block.pdf_url }}" target="_blank" style="display: inline-block; background: var(--accent-color, #ff8c00); color: #000; padding: 15px 30px; font-family: monospace; font-size: 1.2rem; font-weight: bold; text-decoration: none; cursor: pointer; transition: 0.3s; text-transform: uppercase;">
        {{ block.button_text | default('OFFLINE ARCHIVE DOWNLOAD') }}
    </a>
    {% else %}
    <button style="display: inline-block; background: transparent; border: 1px solid #555; color: #555; padding: 15px 30px; font-family: monospace; font-size: 1.2rem; cursor: not-allowed; text-transform: uppercase;">
        [ ΑΡΧΕΙΟ ΜΗ ΔΙΑΘΕΣΙΜΟ ]
    </button>
    {% endif %}
</div>
